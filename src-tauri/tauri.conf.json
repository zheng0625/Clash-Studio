{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash Studio",
  "version": "1.3.0",
  "identifier": "studio.clash.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir frontend build",
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Clash Studio",
        "width": 840,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#f5f5fa",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
