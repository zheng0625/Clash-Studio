{
  "name": "clash-studio",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "brand:icons": "node ../scripts/build-brand-icons.cjs",
    "dev:android-components": "vite --host 127.0.0.1 --port 5181 --strictPort --open /ui-android-components.html",
    "dev:components": "vite --host 127.0.0.1 --port 5181 --strictPort --open /ui-components.html",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.cjs",
    "test:browser": "node ../scripts/verify-frontend-save-audit.cjs",
    "check": "pnpm test && pnpm build",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0"
  },
  "license": "GPL-3.0-only"
}
